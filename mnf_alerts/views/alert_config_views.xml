<odoo>

    <record id="action_alert_config" model="ir.actions.act_window">
        <field name="name">Alert Configurations</field>
        <field name="res_model">mnf.alert.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_alert_config_form" model="ir.ui.view">
        <field name="name">mnf.alert.config.form</field>
        <field name="model">mnf.alert.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="alert_id"/>
                    </group>

                    <notebook>

                        <page string="Users">
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                        </page>

                        <page string="Schedule">
                            <group>
                                <field name="duration_value"/>
                                <field name="duration_unit"/>
                                <field name="last_send_time" readonly="1"/>
                            </group>
                        </page>

                        <page string="Notifications">
                        <group>
                            <field name="allow_web"/>
                           
                        </group>    
                        </page>

                    </notebook>

                    <footer>
                        <button name="button_run_alerts"
                                type="object"
                                string="Run Now"
                                class="btn-primary"/>
                    </footer>

                </sheet>
            </form>
        </field>
    </record>

</odoo>